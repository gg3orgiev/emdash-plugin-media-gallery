{
  "name": "emdash-plugin-media-gallery",
  "version": "0.2.0",
  "description": "A multi-image gallery field for EmDash CMS: ordered media arrays with per-item metadata, a primary flag, and media search.",
  "type": "module",
  "license": "MIT",
  "author": "Georgi Georgiev (https://github.com/gg3orgiev)",
  "homepage": "https://github.com/gg3orgiev/emdash-plugin-media-gallery#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gg3orgiev/emdash-plugin-media-gallery.git"
  },
  "bugs": {
    "url": "https://github.com/gg3orgiev/emdash-plugin-media-gallery/issues"
  },
  "keywords": [
    "emdash",
    "emdash-plugin",
    "cms",
    "gallery",
    "media",
    "images",
    "field",
    "widget",
    "astro"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@emdash-cms/admin": ">=0.30.0",
    "emdash": ">=0.30.0",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@emdash-cms/admin": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emdash-cms/admin": "^0.32.0",
    "@types/react": "^19.2.16",
    "emdash": "^0.32.0",
    "react": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
